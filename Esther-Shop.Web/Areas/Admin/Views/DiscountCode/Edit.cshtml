@using Esther_Shop.Web.Areas.Admin.Models.DiscountCode
@model CreateDiscountCodeModel
@{
    ViewData["Title"] = " ویرایش کد تخفیف ";
}
<section class="content-header">
    <h1>@ViewData["Title"] </h1>
    <ol class="breadcrumb">
        <li><a><i asp-area="Admin" asp-controller="Home" asp-action="Index" class="fa fa-dashboard"></i> خانه</a></li>
        <li><a><i asp-area="Admin" asp-controller="DiscountCode" asp-action="Index" class="fa fa-dashboard"></i>  کدهای تخفیف </a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
</section>
<section class="content">
    <form class="box box-danger" method="post" asp-area="Admin" asp-controller="DiscountCode" asp-action="Create">
        <div class="box-body row">
            <div class="col-md-6">
                @Html.EditorFor(m => m.Code)
            </div>
            <div class="col-md-6">
                @Html.EditorFor(m => m.Precent)
            </div>
            <div class="col-md-6">
                @Html.EditorFor(m => m.ExpireTime)
            </div>
            <div class="col-md-6">
                @Html.EditorFor(m => m.IsActive)
            </div>
            <div class="box-footer">
                <button class="btn btn-success" type="submit">ثبت اطلاعات</button>
            </div>
        </div>
    </form>
</section>