@using Esther_Shop.CoreLayer.Utilities
@model BasePagination
@if (Model.PageCount > 1)
{
	<div class="box-footer">
		<div style="padding:10px">
			<ul class="pagination" style="display:inline-block">
				@if (Model.CurrentPage > 1)
				{
					<li class="paginate_button previous">
						<a onclick="ChangePage(@(Model.CurrentPage-1))" href="javascript:void(0)">قبلی</a>
					</li>
				}
				else
				{
					<li class="paginate_button previous disabled">
						<a onclick="ChangePage(@(Model.CurrentPage - 1))" href="javascript:void(0)">قبلی</a>
				</li>
				}
				@for (var i = Model.StartPage; i <= Model.EndPage; i++)
				{
					<li class="paginate_button @(Model.CurrentPage==i?"active":null)  ">
						<a onclick="ChangePage(@(i))" href="#">@i</a>
				</li>
				}
				@if (Model.PageCount > Model.CurrentPage)
				{
					<li class="paginate_button next">
						<a onclick="ChangePage(@(Model.CurrentPage + 1))" href="javascript:void(0)">بعدی</a>
					</li>
				}
				else
				{
					<li class="paginate_button next disabled">
						<a onclick="ChangePage(@(Model.CurrentPage +1))" href="javascript:void(0)">بعدی</a>
				</li>
				}

			</ul>

			</div>
     </div>


}