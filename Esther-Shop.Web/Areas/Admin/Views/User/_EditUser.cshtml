@using Esther_Shop.CoreLayer.Dtos.Users
@model EditUserDto
<form method="post" asp-area="admin"   asp-controller="User" asp-action="Edit">
	<div class="row">
		<div class="col-md-6">@Html.EditorFor(m=>m.FullName)</div>
	</div>
	<div class="row">
		<div class="col-md-6">@Html.EditorFor(m => m.Role)</div>
	</div>
	@Html.HiddenFor(d=>d.UserId)
	<button type="submit" class="btn btn-success">Edit</button>
</form>