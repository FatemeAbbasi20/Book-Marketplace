@using Esther_Shop.CoreLayer.Dtos.Products
@using Esther_Shop.CoreLayer.Utilities
@model ProductFilterDto
@{
    ViewData["Title"] = " محصولات";
    ViewData["Selected"] = "product";
    var Counter = 1;
}
<section class="content-header">
    <h1>@ViewData["Title"] </h1>
    <ol class="breadcrumb">
        <li><a><i asp-area="Admin" asp-controller="Product" asp-action="Index" class="fa fa-dashboard"></i> خانه</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
</section>

<section class="content">
    <div class="box box-danger">
        <div class="box box-body">
            <form>
            <div class="box-header"><button type="submit" class="btn btn-info pull-left">فیلتر</button></div>
            <div class="row">
                <div class="col-md-6 form-group">
                    <input class="form-control" type="text" placeholder="title" name="title" value="@Model.FilterParams.Title"/>
                </div>
                <div class="col-md-6 form-group">
                    <input class="form-control" type="text" placeholder="slug" name="categorySlug" value="@Model.FilterParams.CategorySlug" />
                </div>
            </div>
            </form>
        </div>
    </div>





    <a class="btn btn-success" style="margin-bottom:5px" asp-area="Admin" asp-controller="Product" asp-action="Create">افزودن محصول جدید</a>
    <div class=" box box-primary">
        <div class="box-body p-0">
            <table class="table table-bordered" table-hover>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>عکس</th>
                        <th>عنوان</th>
                        <th>slug</th>
                        <th>قیمت</th>
                        <th>موجودی</th>
                        <th>نویسنده</th>
                        <th>ناشر</th>
                        <th>مترجم</th>
                        <th>گالری تصاویر </th>
                        <th>گروه</th>
                        <th>پست ویژه</th>
                        <th> اسلایدر</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td>@Counter</td>
                            <td><img style="max-width: 150px" src=@Directions.GetProductImage(item.MainImageName) />
                            <td>@item.Title</td>
                            <td>@item.Slug</td>
                            <td>@item.Price</td>
                            <td>@item.Stock</td>
                            <td>@item.Author</td>
                            <td>@item.Publisher</td>
                            <td>@item.Trenslator</td>
                            <td>
                                @if (item.GalleryImages.Any())
                                {
                                    <img src=" @Directions.GetProductImage(item.GalleryImages.First())" width="60" />
                                    <span class="badge bg-blue">@item.GalleryImages.Count</span>

                                }
                            </td>
                            <td>@item.Category?.Title??null"-"</td>
                            <td>
                                @if (item.IsSpecial==true)
                                {
                                    <i class="fa fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fa fa-close text-danger"></i>

                                }
                            </td>
                            <td>
                                @if (item.IsInSlider == true)
                                {
                                    <i class="fa fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fa fa-close text-danger"></i>

                                }
                            </td>
                            <td><a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-info sm">ویرایش</a></td>
   

                        </tr>
                        Counter += 1;
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model"/>
    </div>
</section>
<!-- /.content -->
