@using Esther_Shop.Web.Areas.Admin.Models
@using Esther_Shop.Web.Areas.Admin.Models.Category
@model EditCategoryArticleViewModel
@{
    ViewData["Title"] = "ویرایش دسته بندی";
}
<section class="content-header">
    <h1>@ViewData["Title"] </h1>
    <ol class="breadcrumb">
        <li><a><i asp-area="Admin" asp-controller="Home" asp-action="Index" class="fa fa-dashboard"></i> خانه</a></li>
        <li><a><i asp-area="Admin" asp-controller="Category" asp-action="Index" class="fa fa-dashboard"></i>  دسته بندی ها</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
</section>

<section class="content">
    <form class="box box-danger" method="post" asp-area="Admin" asp-controller="Category" asp-action="Edit">
        <div class="box-body row">
            <div class="col-md-6">
                @Html.EditorFor(m => m.Title)
            </div>
            <div class="col-md-6">
                @Html.EditorFor(m => m.Slug)
            </div>
            <div class="col-md-6">
                @Html.EditorFor(m => m.MetaDescription)
            </div>
        </div>
        <div class="box-footer" >
            <button class="btn btn-success" typee="submit">ثبت اطلاعات</button>
            </div>
    </form>
</section>