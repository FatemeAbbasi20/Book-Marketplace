<!--product area start-->
<section class="product_area mb-60">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="product_header">
                    <div class="section_title">
                        <h2>تازه رسیده ها</h2>
                    </div>
                    <div class="product_tab_button">
                        <ul class=" nav" role="tablist">
                            @foreach (var item in Model.PageData.Categories.Where(f=>f.ParentId==null))
                            {
                                <li>
                                    <a class="active" data-toggle="tab" href="#" onclick="GetNewestProductsBySlug('@item.Slug')" role="tab" aria-controls="automobiles" aria-selected="true">@item.Title</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-content" id="NewestProducts">
            <partial name="_NewestProducts" model="Model.PageData.NewestProducts" />  </div>
    </div>
</section>
<!--product area end-->
<!--small product area start-->
<section class="small_product_area mb-60">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section_title">
                    <h2>محصولات ویژه </h2>
                </div>
                <div class="product_carousel small_product small_product_column3 owl-carousel">
                    <div class="product_items">
                        @foreach(var Product in Model.PageData.SpecialProducts){
                        <div class="single_product">
                            <div class="product_thumb">
                                <a class="primary_img" href="#"><img src="@Directions.GetProductImage(Product.MainImageName)" alt="@Product.Title"></a>
                            </div>
                            <div class="product_content">
                                <p class="manufacture_product"><a href="#">عنوان محصول</a></p>
                                <h4><a href="product-details.html">@Product.Title</a></h4>
                                <div class="price_box">
                                    @if (Product.DiscountPrecent > 0)
                                    {
                                        <span class="old_price">@Product.Price تومان</span>
                                    }
                                    <span class="current_price">@Product.GetFinalPrice() تومان</span>
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--small product area end-->
@section Scripts{
<script>
function GetNewestProductsBySlug(slug){
    $.ajax({url:"/Index/GetNewestProducts?slug="+slug, type:"get",
             beforeSend:function(){
                        $(".loading").show();},
                        complete:function(){
                            $(".loading").hide();
                        }
    }).done(function(data){
        $("#NewestProducts").html(data);
    });
};
</script>
}
