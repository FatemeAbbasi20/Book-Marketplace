@section Scripts{
     <script>
         function AddtoCart()
         {
           var ProductId= document.getElementById("Id").value;
           var Count= document.getElementById("Count").value;
           fetch('/Cart?handler=Add',{
           method:'Post',headers:{'Content-Type':'application/json'},
           body:JSON.stringify({ProductId:ProductId,Count:Count})
         }).then(response=>response.json())
         .then(data=>{
            if(data.success)Swal.fire("موفق", "به سبد اضافه شد", "success");
            else Swal.fire("خطا", data.message, "error");
         });
         } 
     </script>
 }