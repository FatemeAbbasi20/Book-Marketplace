                        </a>
                    </div>
                    <div class="single-zoom-thumb">
                        <ul class="s-tab-zoom owl-carousel single-product-active" id="gallery_01">
                            @if(Model.Product.GalleryImages?.Any()==true){
                            @foreach (var image in Model.Product.GalleryImages)
                            {
                                <li>
                                    <a href="#" class="elevatezoom-gallery active" data-update="" data-image="@Directions.GetGalleryProductImage(image)" data-zoom-image="@Directions.GetGalleryProductImage(image)">
                                        <img src="@Directions.GetGalleryProductImage(image)" alt="@Model.Product.Title" />
                                    </a>
                                </li>
                            }
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="product_d_right">
                 

                        <h1>@Model.Product.Title </h1>
                        <div class="product_nav">
                            <ul>
              
                                <li class="prev"><a asp-action="Product" asp-route-Slug="@PreProduct.Slug"><i class="fa fa-angle-left">@PreProduct.Title</i></a></li>
                            <li class="next"><a asp-action="Product" asp-route-Slug="@NextProduct.Slug"><i class="fa fa-angle-right"></i>@NextProduct.Title</a></li>
                            </ul>
                        </div>
                        <div class=" product_ratting">
                            <ul>
                                <li><i class="fa fa-star"></i></li>
                                <li><i class="fa fa-star"></i></li>
                                <li><i class="fa fa-star"></i></li>
                                <li><i class="fa fa-star"></i></li>
                                <li><i class="fa fa-star"></i></li>
                                <li class="review">(@Model.Comments.Count نظر)</li>
                            </ul>
                        <div class="product_meta">
                            <span>
                                <i class="fa fa-eye"></i>
                                @Model.Product.Visit بازدید
                            </span>
                        </div>
                        </div>
                        <div class="price_box">
                            @if (Model.Product.DiscountPrecent <= 0)
                            {
                                <span class="old_price">@Model.Product.Price تومان </span>
                            }
                            <span class="current_price">@Model.Product.GetFinalPrice() تومان</span>
                        </div>
                        <div class="product_desc">
                            <p>@Html.Raw(Model.Product.Description)</p>
                        </div>
                        @* <div class="product_variant color">
                                <h3>گزینه های موجود</h3>
                                <label>رنگ</label>
                                <ul>
                                    <li class="color1"><a href="#"></a></li>
                                    <li class="color2"><a href="#"></a></li>
                                    <li class="color3"><a href="#"></a></li>
                                    <li class="color4"><a href="#"></a></li>
                                </ul>
                            </div> *@

                        @* <div class="product_variant size">
                                <label>اندازه</label>
                                <select class="niceselect_option" id="color2" name="produc_color2">
                                    <option selected value="1"> اندازه در گزینه</option>
                                    <option value="2">s</option>
                                    <option value="3">m</option>
                                    <option value="4">l</option>
                                    <option value="5">xl</option>
                                    <option value="6">xxl</option>
                                </select>
                            </div> *@

                        <div class="product_variant quantity">
                            <label>تعداد</label>
                        <input min="1" max="@Model.Product.Stock" id="Count" value="1" type="number" @(Model.Product.Stock == 0 ? "disabled" : "" )>
                        <input type="hidden" asp-for="Product.Id" />
                        @* <input type="hidden"asp-for="Product.Stock" /> *@
                        <button class="button" type="button" onclick="AddToCart()" @(Model.Product.Stock == 0 ? "disabled" : "")>افزودن به سبد</button>
                        </div>

                   
                        @* <div class=" product_d_action">
                                <ul>
                                    <li><a href="#" title="افزودن به علاقه مندیها">+ افزودن به علاقه مندیها</a></li>
                                    <li><a href="#" title="مقایسه محصول">+ مقایسه</a></li>
                                </ul>
                            </div> *@

              

                    <div class="product_d_meta">
                        <span>@Model.Product.Author:نویسنده</span>
                        <span>دسته: <a asp-page="Search" asp-route-CategorySlug="@Model.Product.Category?.Slug">@Model.Product.Category?.Title</a></span>
                        @* <span>
                                برچسب:
                                <a href="#">دریل</a>
                                <a href="#">جعبه</a>
                            </span> *@
                    </div>
                    <div class="product_social">
                        <ul>

                            <li class="facebook"><a href="https://www.facebook.com/sharer/sharer.php?u=@Url"><i class="fa fa-facebook"></i></a></li>
                            <li class="twitter"><a href="https://twitter.com/intent/tweet?url=@Url"><i class="fa fa-twitter"></i></a></li>
                            <li class="whatsapp"><a href="https://wa.me?text=@Url"><i class="fa fa-whatsapp"></i></a></li>
                            <li class="telegram"><a href="https://t.me/share/url?url=@Url"><i class="fa fa-telegram"></i></a></li>

                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


