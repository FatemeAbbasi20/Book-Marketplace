@page "{Slug}"
@using Esther_Shop.CoreLayer.Services.Product
@using Esther_Shop.CoreLayer.Utilities
@using DataLayer.Entities
@using Microsoft.AspNetCore.Http.Extensions
@model Esther_Shop.Web.Pages.Shared.ProductModel
@inject IProductService _productService;
@{
    var Url = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/{HttpContext.Request.Path}";
    var PreProduct = _productService.GetPreProduct(Model.Product.ProductId);
    var NextProduct = _productService.GetNextProduct(Model.Product.ProductId);
    var imageUrl = @Directions.GetProductImage(Model.Product.MainImageName);
    var imageType = System.IO.Path.GetExtension(Model.Product.MainImageName).Replace(".","");
  
}
@section MetaTags{
    <meta name="description" content="@Model.Product.MetaDescription" />
    <meta name="og:description" content="@Model.Product.MetaDescription" />
    <meta name="twitter:description" content="@Model.Product.MetaDescription" /> 
     <meta property="og:image" content="@imageUrl" />
    <meta name="og:image:type" content="image/@imageType" />
     <meta property="og:type" content="product" />
    <meta name="twitter:image" content="@imageUrl" />
    <meta name="og:url" content="@HttpContext.Request.GetDisplayUrl()" />
    <link rel="canonical" href="@HttpContext.Request.GetDisplayUrl()" />
    <meta name="twitter:title" content="@Model.Product.Title" />
    <meta property="og:title" content="@Model.Product.Title" />
}

<div class="breadcrumbs_area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb_content">
                    <ul>
                        <li><a asp-page="Index">صفحه اصلی</a></li>
                        <li><a asp-page="Search" asp-route-CategorySlug="@Model.Product.Category?.Slug"> @Model.Product.Category?.Title</a>  </li>
                        @if (Model.Product.SubCategory != null)
                        {
                        <li><a asp-page="Search" asp-route-SubCategorySlug="@Model.Product.SubCategory?.Slug"> @Model.Product.SubCategory?.Title</a>  </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!--product details start-->
<div class="product_details variable_product mt-30">
