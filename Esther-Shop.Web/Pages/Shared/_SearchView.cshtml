@using Esther_Shop.CoreLayer.Dtos.Products
@using Esther_Shop.CoreLayer.Utilities
@model ProductSearchDto
@foreach (var Product in Model.Products)
{
    var GalleryImage = Product.GalleryImages.FirstOrDefault();
    var PathGalleryImage = GalleryImage != null ? Directions.GetGalleryProductImage(GalleryImage) : "/images/no-images.jpg";
    <div class="single_product">
        <div class="product_thumb">
            <a class="primary_img" href="#"><img src="@Directions.GetProductImage(Product.MainImageName)" alt="@Product.Title"></a>
            <a class="secondary_img" href="#"><img src="PathGalleryImage" alt="@Product.Title"></a>
            <div class="label_product">
                <span class="label_sale">@Product.DiscountPrecent%</span>
            </div>

            @* <div class="action_links">
                                        <ul>
                                            <li class="wishlist"><a href="wishlist.html" title="افزودن به علاقه مندیها"><i class="icon-heart"></i></a></li>
                                            <li class="compare"><a href="compare.html" title="مقایسه"><i class="icon-repeat"></i></a></li>
                                            <li class="quick_button"><a href="#" data-toggle="modal" data-target="#modal_box" title="نمایش سریع"> <i class="icon-eye"></i></a></li>
                                        </ul>
                                    </div> *@
            <div class="add_to_cart">
                <a asp-Page="ShoppingCart" title="افزودن به سبد">افزودن به سبد</a>
                @(Product.Stock == 0 ? "disabled" : "")
            </div>
        </div>
        <div class="product_content grid_content">
            <p class="manufacture_product">عنوان محصول</p>
            <h4><a href="product-details.html">@Product.Title</a></h4>
            <div class="price_box">
                @if (Product.DiscountPrecent > 0)
                {
                    <span class="old_price">@Product.Price تومان</span>
                }
                <span class="current_price">@Product.GetFinalPrice() تومان</span>
            </div>
        </div>
        <div class="product_content list_content">
            <div class="left_caption">
                <p class="manufacture_product"><a href="#">عنوان محصول </a></p>
                <h4><a href="product-details.html">@Product.Title</a></h4>
                <div class="product_desc">
                    <p>@Html.Raw(Product.Description) </p>
                </div>
            </div>
            <div class="right_caption">
                <div class="text_available">
                    <p>در دسترس: <span>@Product.Stock موجود در انبار</span> @(Product.Stock == 0 ? "disabled" : "")</p>
                </div>
                <div class="price_box">
                    @if (Product.DiscountPrecent > 0)
                    {
                        <span class="old_price">@Product.Price تومان</span>
                    }
                    <span class="current_price">@Product.GetFinalPrice() تومان</span>
                </div>
                <div class="cart_links_btn  @(Product.Stock == 0 ? "disabled" : "")">
                    <a asp-page="ShoppingCart" title="افزودن به سبد">افزودن به سبد</a>
                   
                </div>
                 <div class="action_list_links">
                    <OpenModal url="@Url.Action("ProductModal", "Index", new { Slug = Product.Slug })" title="@Product.Title" class="quick_button"> <i class="icon-eye"></i></OpenModal>
                                            @* <ul>
                                                <li class="wishlist"><a href="wishlist.html" title="افزودن به علاقه مندیها"><i class="icon-heart"></i></a></li>
                                                <li class="compare"><a href="compare.html" title="مقایسه"><i class="icon-repeat"></i></a></li>
                                                <li class="quick_button"><a href="#" data-toggle="modal" data-target="#modal_box" title="نمایش سریع"> <i class="icon-eye"></i></a></li>
                                            </ul> *@
                                        </div> 
            </div>
        </div>
    </div>
}
@if (Model.PageCount > 1)
{
    <div class="shop_toolbar t_bottom">
        <div class="pagination">
            <ul>
                @for (var i = 1; i <= Model.PageCount; i++)
                {
                    @if (Model.CurrentPage == i)
                    {
                        <li class="current"><a href="#">@i</a></li>
                    }

                    else
                    {
                        <li ><a href="javascript:void(0)" onclick="AjaxPagination(@i)">@i</a></li>
                    }
                }

                @if (Model.PageCount > Model.CurrentPage)
                {
                    <li class="next"><a href="javascript:void(0)" onclick="AjaxPagination(@(Model.CurrentPage + 1))">بعدی</a></li>
                }

            </ul>
        </div>
    </div>
}